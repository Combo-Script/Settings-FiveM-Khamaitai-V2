New-SectionHeader -parent $leftPanel -text "MODULES" -top 347 | Out-Null

$modules = @(
    @{ tag = "SYS";   label = "Timer Precision" },
    @{ tag = "POWER"; label = "Performance Plan" },
    @{ tag = "INPUT"; label = "Input Tuning" },
    @{ tag = "NET";   label = "Network Stack" },
    @{ tag = "APP";   label = "Background Cleanup" },
    @{ tag = "TEMP";  label = "Temp Files" }
)

$moduleLabels = @{}
$yOff = 378
foreach ($mod in $modules) {
    $dot = New-Object System.Windows.Forms.Panel
    $dot.Left      = 24
    $dot.Top       = $yOff + 4
    $dot.Width     = 6
    $dot.Height    = 6
    $dot.BackColor = $cGrayMid
    $leftPanel.Controls.Add($dot)

    $lTag = New-Object System.Windows.Forms.Label
    $lTag.Text      = $mod.tag
    $lTag.ForeColor = $cGray
    $lTag.Font      = $fontMonoXs
    $lTag.Width     = 48
    $lTag.Left      = 36
    $lTag.Top       = $yOff
    $leftPanel.Controls.Add($lTag)

    $lName = New-Object System.Windows.Forms.Label
    $lName.Text      = $mod.label
    $lName.ForeColor = $cGray
    $lName.Font      = $fontMonoXs
    $lName.AutoSize  = $true
    $lName.Left      = 88
    $lName.Top       = $yOff
    $leftPanel.Controls.Add($lName)

    $moduleLabels[$mod.tag] = @{ dot = $dot; tag = $lTag; name = $lName }
    $yOff += 20
}

