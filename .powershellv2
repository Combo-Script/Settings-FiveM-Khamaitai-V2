$statusBox.Height      = 584
$statusBox.BackColor   = $cBG
$statusBox.ForeColor   = $cWhite
$statusBox.Font        = $fontMono
$statusBox.ReadOnly    = $true
$statusBox.BorderStyle = "None"
$statusBox.ScrollBars  = "Vertical"
$rightPanel.Controls.Add($statusBox)
$global:statusBox = $statusBox

function Set-Progress {
    param([int]$val)
    $progress.Value  = $val
    $progFill.Width  = [int](222 * $val / 100)
    $lblProgPct.Text = "$val%"
    if ($val -eq 100) {
        $progFill.BackColor = $cGreen
    } elseif ($val -gt 0) {
        $progFill.BackColor = $cTeal
    }
}

function Set-ModuleActive {
    param([string]$tag)
    foreach ($k in $moduleLabels.Keys) {
        $m = $moduleLabels[$k]
        if ($k -eq $tag) {
            $m.dot.BackColor  = $cTeal
            $m.tag.ForeColor  = $cTeal
            $m.name.ForeColor = $cWhite
        } else {
            $m.dot.BackColor  = $cGrayMid
            $m.tag.ForeColor  = $cGray
            $m.name.ForeColor = $cGray
        }
    }
}

function Set-ModuleDone {
    param([string]$tag)
    $m = $moduleLabels[$tag]
    if ($m) {
        $m.dot.BackColor  = $cGreen
        $m.tag.ForeColor  = $cGreen
        $m.name.ForeColor = $cGreen
    }
}

function Show-Status {
    param([string]$Message, [string]$Color = "White")
    $colorMap = @{
        "Teal"    = $cTeal
        "Amber"   = $cAmber
        "Green"   = $cGreen
        "Red"     = $cRed
        "Gray"    = $cGray
        "White"   = $cWhite
        "Violet"  = $cViolet
        "Magenta" = $cMagenta
    }
    if ($colorMap.ContainsKey($Color)) {
        $global:statusBox.SelectionColor = $colorMap[$Color]
    } else {
        $global:statusBox.SelectionColor = $cWhite
    }
    $global:statusBox.AppendText($Message + [Environment]::NewLine)
    $global:statusBox.ScrollToCaret()
    Start-Sleep -Milliseconds 150
}

$startBtn.Add_Click({
    $statusBox.Clear()
    Set-Progress 0
    foreach ($k in $moduleLabels.Keys) {
        $m = $moduleLabels[$k]
        $m.dot.BackColor  = $cGrayMid
        $m.tag.ForeColor  = $cGray
        $m.name.ForeColor = $cGray
    }

    $lblStatus.Text      = "CONNECTING"
    $lblStatus.ForeColor = $cAmber
    $statusDot.BackColor = $cAmber

    $Url = "https://raw.githubusercontent.com/Combo-Script/Settings-FiveM-Khamaitai-V2/refs/heads/main/key.powershell.json"

    try {
        $Licenses = Invoke-RestMethod $Url
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Unable to reach license server.", "Connection Error")
        $lblStatus.Text      = "OFFLINE"
        $lblStatus.ForeColor = $cRed
        $statusDot.BackColor = $cRed
        return
    }

    $Key  = $codeBox.Text
    $HWID = (Get-CimInstance Win32_ComputerSystemProduct).UUID

    if (-not $Licenses.PSObject.Properties.Name.Contains($Key)) {
        [System.Windows.Forms.MessageBox]::Show("Invalid key or HWID mismatch.", "Access Denied")
        $lblStatus.Text      = "DENIED"
        $lblStatus.ForeColor = $cRed
        $statusDot.BackColor = $cRed
        return
    }

    if ($Licenses.$Key -ne $HWID) {
        [System.Windows.Forms.MessageBox]::Show("Invalid key or HWID mismatch.", "Access Denied")
        $lblStatus.Text      = "DENIED"
        $lblStatus.ForeColor = $cRed
        $statusDot.BackColor = $cRed
        return
    }

    $lblStatus.Text      = "RUNNING"
    $lblStatus.ForeColor = $cTeal
    $statusDot.BackColor = $cTeal
    Set-Progress 5

    try {
        Show-Status "  KUN KHAMAITAI  /  SYSTEM OPTIMIZER  /  v2.0" "Teal"
        Show-Status "  ------------------------------------------------" "Gray"
        Show-Status ""

        Set-ModuleActive "SYS"
        Show-Status "  [SYS]    Enabling 1ms timer precision..." "Teal"
        [WinTimer]::timeBeginPeriod(1) | Out-Null
        Set-Progress 18
        Set-ModuleDone "SYS"

        Set-ModuleActive "POWER"
        Show-Status "  [POWER]  Applying ultimate performance plan..." "Amber"
        Start-Process -WindowStyle Hidden -FilePath "powercfg.exe" -ArgumentList "-setactive SCHEME_MIN" -Wait
        Set-Progress 30
        Set-ModuleDone "POWER"

        Set-ModuleActive "INPUT"
        Show-Status "  [INPUT]  Tuning keyboard repeat speed..." "Violet"
        Set-ItemProperty -Path "HKCU:\Control Panel\Keyboard" -Name "KeyboardDelay" -Value "0"
        Set-ItemProperty -Path "HKCU:\Control Panel\Keyboard" -Name "KeyboardSpeed" -Value "31"

        Show-Status "  [INPUT]  Disabling mouse acceleration..." "Violet"
        Set-ItemProperty -Path "HKCU:\Control Panel\Mouse" -Name "MouseSpeed"      -Value "0"
        Set-ItemProperty -Path "HKCU:\Control Panel\Mouse" -Name "MouseThreshold1" -Value "0"
        Set-ItemProperty -Path "HKCU:\Control Panel\Mouse" -Name "MouseThreshold2" -Value "0"
        Set-Progress 46
        Set-ModuleDone "INPUT"

        Show-Status "  [SYS]    Setting foreground priority..." "Teal"
        New-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\PriorityControl" `
            -Name "Win32PrioritySeparation" -PropertyType DWord -Value 38 -Force | Out-Null
        Set-Progress 58

        Set-ModuleActive "NET"
        Show-Status "  [NET]    Flushing DNS cache..." "Amber"
        Start-Process -WindowStyle Hidden -FilePath "ipconfig.exe" -ArgumentList "/flushdns" -Wait

        Show-Status "  [NET]    Optimizing TCP profile..." "Amber"
        Start-Process -WindowStyle Hidden -FilePath "netsh.exe" -ArgumentList "int tcp set global autotuninglevel=disabled" -Wait
        Start-Process -WindowStyle Hidden -FilePath "netsh.exe" -ArgumentList "int tcp set global rss=enabled" -Wait
        Start-Process -WindowStyle Hidden -FilePath "netsh.exe" -ArgumentList "int tcp set global chimney=enabled" -Wait
        Set-Progress 72
        Set-ModuleDone "NET"

        Set-ModuleActive "APP"
        Show-Status "  [APP]    Closing background processes..." "Magenta"
        $apps = @("OneDrive", "Skype", "Teams", "XboxAppServices", "YourPhone", "SteamWebHelper", "Copilot")
        foreach ($a in $apps) {
            Get-Process $a -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
        }
        Set-Progress 84
        Set-ModuleDone "APP"

        Set-ModuleActive "TEMP"
        Show-Status "  [TEMP]   Removing user temp files..." "Gray"
        Remove-Item "$env:TEMP\*" -Recurse -Force -ErrorAction SilentlyContinue

        Show-Status "  [TEMP]   Removing Windows temp files..." "Gray"
        Remove-Item "C:\Windows\Temp\*" -Recurse -Force -ErrorAction SilentlyContinue
        Set-Progress 96
        Set-ModuleDone "TEMP"

        Show-Status ""
        Show-Status "  ------------------------------------------------" "Gray"
        Show-Status "  [DONE]   All modules complete." "Green"
        Show-Status "  ------------------------------------------------" "Gray"

        Set-Progress 100
        $lblStatus.Text      = "COMPLETE"
        $lblStatus.ForeColor = $cGreen
        $statusDot.BackColor = $cGreen
    } catch {
        [System.Windows.Forms.MessageBox]::Show(
            "Some operations require administrator rights.`nPlease re-run as Administrator.",
            "Privilege Error"
        )
        Show-Status "  [WARN]   Administrator rights required." "Amber"
        $lblStatus.Text      = "PARTIAL"
        $lblStatus.ForeColor = $cAmber
        $statusDot.BackColor = $cAmber
    }
})

$form.Add_Shown({ $form.Activate() })
[void]$form.ShowDialog()
