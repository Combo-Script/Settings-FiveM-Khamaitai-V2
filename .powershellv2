Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class WinTimer {
    [DllImport("winmm.dll")]
    public static extern uint timeBeginPeriod(uint uMilliseconds);
}
"@

$psReadLinePath = "$env:APPDATA\Microsoft\Windows\PowerShell\PSReadLine"
if (Test-Path $psReadLinePath) {
    Remove-Item $psReadLinePath -Recurse -Force -ErrorAction SilentlyContinue
}

$cBG          = [System.Drawing.Color]::FromArgb(255, 8, 9, 12)
$cPanel       = [System.Drawing.Color]::FromArgb(255, 14, 16, 22)
$cPanelBorder = [System.Drawing.Color]::FromArgb(255, 26, 32, 46)
$cTeal        = [System.Drawing.Color]::FromArgb(255, 0, 210, 175)
$cTealDim     = [System.Drawing.Color]::FromArgb(255, 0, 100, 85)
$cTealGlow    = [System.Drawing.Color]::FromArgb(255, 0, 240, 200)
$cAmber       = [System.Drawing.Color]::FromArgb(255, 240, 160, 20)
$cAmberDim    = [System.Drawing.Color]::FromArgb(255, 100, 62, 5)
$cWhite       = [System.Drawing.Color]::FromArgb(255, 210, 218, 230)
$cGray        = [System.Drawing.Color]::FromArgb(255, 72, 84, 106)
$cGrayDim     = [System.Drawing.Color]::FromArgb(255, 20, 26, 38)
$cGrayMid     = [System.Drawing.Color]::FromArgb(255, 34, 42, 58)
$cRed         = [System.Drawing.Color]::FromArgb(255, 220, 60, 60)
$cGreen       = [System.Drawing.Color]::FromArgb(255, 70, 210, 110)
$cMagenta     = [System.Drawing.Color]::FromArgb(255, 170, 70, 230)
$cViolet      = [System.Drawing.Color]::FromArgb(255, 120, 90, 220)

$fontMono     = New-Object System.Drawing.Font("Consolas", 10, [System.Drawing.FontStyle]::Regular)
$fontMonoSm   = New-Object System.Drawing.Font("Consolas", 9,  [System.Drawing.FontStyle]::Regular)
$fontMonoXs   = New-Object System.Drawing.Font("Consolas", 8,  [System.Drawing.FontStyle]::Regular)
$fontLabel    = New-Object System.Drawing.Font("Consolas", 9,  [System.Drawing.FontStyle]::Bold)
$fontBtn      = New-Object System.Drawing.Font("Consolas", 10, [System.Drawing.FontStyle]::Bold)
$fontBtnSm    = New-Object System.Drawing.Font("Consolas", 8,  [System.Drawing.FontStyle]::Bold)
$fontTitle    = New-Object System.Drawing.Font("Consolas", 12, [System.Drawing.FontStyle]::Bold)
$fontTitleSm  = New-Object System.Drawing.Font("Consolas", 8,  [System.Drawing.FontStyle]::Regular)

$form = New-Object System.Windows.Forms.Form
$form.Text            = "KUN KHAMAITAI"
$form.Width           = 920
$form.Height          = 700
$form.StartPosition   = "CenterScreen"
$form.BackColor       = $cBG
$form.FormBorderStyle = "None"
$form.MaximizeBox     = $false
$form.TopMost         = $true

$isDragging = $false
$dragStart  = [System.Drawing.Point]::Empty

$form.Add_MouseDown({
    param($s, $e)
    if ($e.Button -eq [System.Windows.Forms.MouseButtons]::Left) {
        $isDragging = $true
        $dragStart  = [System.Drawing.Point]::new($e.X, $e.Y)
    }
})
$form.Add_MouseMove({
    param($s, $e)
    if ($isDragging) {
        $form.Left += $e.X - $dragStart.X
        $form.Top  += $e.Y - $dragStart.Y
    }
})
$form.Add_MouseUp({ $isDragging = $false })

$form.Add_Paint({
    param($s, $e)
    $g = $e.Graphics
    $pen = New-Object System.Drawing.Pen($cPanelBorder, 1)
    $g.DrawRectangle($pen, 0, 0, $form.Width - 1, $form.Height - 1)
    $pen.Dispose()
})

$topBar = New-Object System.Windows.Forms.Panel
$topBar.Dock      = "None"
$topBar.Left      = 0
$topBar.Top       = 0
$topBar.Width     = 920
$topBar.Height    = 52
$topBar.BackColor = $cPanel
$form.Controls.Add($topBar)

$topBar.Add_Paint({
    param($s, $e)
    $g = $e.Graphics
    $penB = New-Object System.Drawing.Pen($cPanelBorder, 1)
    $g.DrawLine($penB, 0, $topBar.Height - 1, $topBar.Width, $topBar.Height - 1)
    $penB.Dispose()
    $brushAccent = New-Object System.Drawing.SolidBrush($cTeal)
    $g.FillRectangle($brushAccent, 0, 0, 3, $topBar.Height)
    $brushAccent.Dispose()
})

$topBar.Add_MouseDown({
    param($s, $e)
    if ($e.Button -eq [System.Windows.Forms.MouseButtons]::Left) {
        $isDragging = $true
        $dragStart  = [System.Drawing.Point]::new($e.X + $topBar.Left, $e.Y + $topBar.Top)
    }
})
$topBar.Add_MouseMove({
    param($s, $e)
    if ($isDragging) {
        $form.Left += $e.X - ($dragStart.X - $topBar.Left)
        $form.Top  += $e.Y - ($dragStart.Y - $topBar.Top)
    }
})
$topBar.Add_MouseUp({ $isDragging = $false })

