$hwIdBtn.Add_MouseEnter({ $hwIdBtn.BackColor = [System.Drawing.Color]::FromArgb(255, 20, 42, 50); $hwIdBtn.FlatAppearance.BorderColor = $cTeal })
$hwIdBtn.Add_MouseLeave({ $hwIdBtn.BackColor = $cGrayMid; $hwIdBtn.FlatAppearance.BorderColor = $cTealDim })
$hwIdBtn.Add_Click({
    $hwid = (Get-CimInstance Win32_ComputerSystemProduct).UUID
    [System.Windows.Forms.Clipboard]::SetText($hwid)
    [System.Windows.Forms.MessageBox]::Show(
        "HWID:`n$hwid`n`nCopied to clipboard.",
        "HARDWARE ID",
        [System.Windows.Forms.MessageBoxButtons]::OK,
        [System.Windows.Forms.MessageBoxIcon]::Information
    )
})
$leftPanel.Controls.Add($hwIdBtn)

