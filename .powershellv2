$btnMinimize.ForeColor = $cGray
$btnMinimize.BackColor = $cPanel
$btnMinimize.FlatStyle = "Flat"
$btnMinimize.FlatAppearance.BorderSize = 0
$btnMinimize.Font      = New-Object System.Drawing.Font("Consolas", 13, [System.Drawing.FontStyle]::Regular)
$btnMinimize.Width     = 38
$btnMinimize.Height    = 38
$btnMinimize.Left      = 840
$btnMinimize.Top       = 7
$btnMinimize.Add_Click({ $form.WindowState = "Minimized" })
$btnMinimize.Add_MouseEnter({ $btnMinimize.ForeColor = $cWhite })
$btnMinimize.Add_MouseLeave({ $btnMinimize.ForeColor = $cGray })
$topBar.Controls.Add($btnMinimize)

$btnClose = New-Object System.Windows.Forms.Button
$btnClose.Text      = "x"
$btnClose.ForeColor = $cGray
$btnClose.BackColor = $cPanel
$btnClose.FlatStyle = "Flat"
$btnClose.FlatAppearance.BorderSize = 0
$btnClose.Font      = New-Object System.Drawing.Font("Consolas", 12, [System.Drawing.FontStyle]::Bold)
$btnClose.Width     = 38
$btnClose.Height    = 38
$btnClose.Left      = 878
$btnClose.Top       = 7
$btnClose.Add_Click({ $form.Close() })
$btnClose.Add_MouseEnter({ $btnClose.ForeColor = $cRed; $btnClose.BackColor = [System.Drawing.Color]::FromArgb(255, 40, 16, 16) })
$btnClose.Add_MouseLeave({ $btnClose.ForeColor = $cGray; $btnClose.BackColor = $cPanel })
$topBar.Controls.Add($btnClose)

$leftPanel = New-Object System.Windows.Forms.Panel
$leftPanel.Left      = 0
$leftPanel.Top       = 52
$leftPanel.Width     = 270
$leftPanel.Height    = 648
$leftPanel.BackColor = $cPanel
$form.Controls.Add($leftPanel)

$leftPanel.Add_Paint({
    param($s, $e)
    $g = $e.Graphics
    $pen = New-Object System.Drawing.Pen($cPanelBorder, 1)
    $g.DrawLine($pen, 269, 0, 269, $leftPanel.Height)
    $pen.Dispose()
})

function New-SectionHeader {
    param($parent, $text, $top)
    $lbl = New-Object System.Windows.Forms.Label
    $lbl.Text      = $text
    $lbl.ForeColor = $cTeal
    $lbl.Font      = $fontLabel
    $lbl.AutoSize  = $true
    $lbl.Left      = 24
    $lbl.Top       = $top
    $parent.Controls.Add($lbl)

    $hr = New-Object System.Windows.Forms.Panel
    $hr.Left      = 24
    $hr.Top       = $top + 18
    $hr.Width     = 222
    $hr.Height    = 1
    $hr.BackColor = $cPanelBorder
    $parent.Controls.Add($hr)
    return $hr
}

