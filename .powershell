Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class WinTimer {
    [DllImport("winmm.dll")]
    public static extern uint timeBeginPeriod(uint uMilliseconds);
}
"@

# ──────────────── COLORS ────────────────
$cBG         = [System.Drawing.Color]::FromArgb(255, 10, 12, 16)
$cPanel      = [System.Drawing.Color]::FromArgb(255, 18, 22, 30)
$cPanelBorder= [System.Drawing.Color]::FromArgb(255, 32, 40, 56)
$cTeal       = [System.Drawing.Color]::FromArgb(255, 0, 210, 180)
$cTealDim    = [System.Drawing.Color]::FromArgb(255, 0, 120, 100)
$cAmber      = [System.Drawing.Color]::FromArgb(255, 240, 160, 20)
$cAmberDim   = [System.Drawing.Color]::FromArgb(255, 120, 75, 5)
$cWhite      = [System.Drawing.Color]::FromArgb(255, 220, 225, 235)
$cGray       = [System.Drawing.Color]::FromArgb(255, 80, 90, 110)
$cGrayDim    = [System.Drawing.Color]::FromArgb(255, 40, 48, 64)
$cRed        = [System.Drawing.Color]::FromArgb(255, 230, 70, 70)
$cGreen      = [System.Drawing.Color]::FromArgb(255, 80, 220, 120)
$fontMono    = New-Object System.Drawing.Font("Consolas", 10, [System.Drawing.FontStyle]::Regular)
$fontMonoSm  = New-Object System.Drawing.Font("Consolas", 9,  [System.Drawing.FontStyle]::Regular)
$fontTitle   = New-Object System.Drawing.Font("Consolas", 18, [System.Drawing.FontStyle]::Bold)
$fontSub     = New-Object System.Drawing.Font("Consolas", 9,  [System.Drawing.FontStyle]::Regular)
$fontLabel   = New-Object System.Drawing.Font("Consolas", 9,  [System.Drawing.FontStyle]::Bold)
$fontBtn     = New-Object System.Drawing.Font("Consolas", 10, [System.Drawing.FontStyle]::Bold)

# ──────────────── FORM ────────────────
$form = New-Object System.Windows.Forms.Form
$form.Text             = "KUN KHAMAITAI PROJECT"
$form.Width            = 900
$form.Height           = 680
$form.StartPosition    = "CenterScreen"
$form.BackColor        = $cBG
$form.FormBorderStyle  = "None"
$form.MaximizeBox      = $false
$form.TopMost          = $true

# Drag support (borderless)
$isDragging = $false
$dragStart  = [System.Drawing.Point]::Empty
$form.Add_MouseDown({ param($s,$e)
    if($e.Button -eq [System.Windows.Forms.MouseButtons]::Left){
        $isDragging = $true
        $dragStart  = [System.Drawing.Point]::new($e.X, $e.Y)
    }
})
$form.Add_MouseMove({ param($s,$e)
    if($isDragging){
        $form.Left += $e.X - $dragStart.X
        $form.Top  += $e.Y - $dragStart.Y
    }
})
$form.Add_MouseUp({ $isDragging = $false })

# ──────────────── CUSTOM BORDER via PAINT ────────────────
$form.Add_Paint({
    param($s,$e)
    $pen = New-Object System.Drawing.Pen($cPanelBorder, 1)
    $e.Graphics.DrawRectangle($pen, 0, 0, $form.Width-1, $form.Height-1)
    $pen.Dispose()
})

# ──────────────── TOP BAR ────────────────
$topBar = New-Object System.Windows.Forms.Panel
$topBar.Dock      = "None"
$topBar.Left      = 0
$topBar.Top       = 0
$topBar.Width     = 900
$topBar.Height    = 44
$topBar.BackColor = $cPanel
$form.Controls.Add($topBar)

# Teal accent line at very top
$accentLine = New-Object System.Windows.Forms.Panel
$accentLine.Left      = 0
$accentLine.Top       = 0
$accentLine.Width     = 900
$accentLine.Height    = 2
$accentLine.BackColor = $cTeal
$topBar.Controls.Add($accentLine)

# Title in top bar
$lblTitle = New-Object System.Windows.Forms.Label
$lblTitle.Text      = "KUN KHAMAITAI PROJECT"
$lblTitle.ForeColor = $cWhite
$lblTitle.Font      = New-Object System.Drawing.Font("Consolas", 11, [System.Drawing.FontStyle]::Bold)
$lblTitle.AutoSize  = $true
$lblTitle.Left      = 16
$lblTitle.Top       = 13
$topBar.Controls.Add($lblTitle)

# Version tag
$lblVer = New-Object System.Windows.Forms.Label
$lblVer.Text      = "v2.0"
$lblVer.ForeColor = $cTealDim
$lblVer.Font      = $fontLabel
$lblVer.AutoSize  = $true
$lblVer.Left      = 240
$lblVer.Top       = 16
$topBar.Controls.Add($lblVer)

# Close button
$btnClose = New-Object System.Windows.Forms.Button
$btnClose.Text      = "×"
$btnClose.ForeColor = $cGray
$btnClose.BackColor = $cPanel
$btnClose.FlatStyle = "Flat"
$btnClose.FlatAppearance.BorderSize = 0
$btnClose.Font      = New-Object System.Drawing.Font("Consolas", 14, [System.Drawing.FontStyle]::Regular)
$btnClose.Width     = 36
$btnClose.Height    = 36
$btnClose.Left      = 858
$btnClose.Top       = 4
$btnClose.Add_Click({ $form.Close() })
$btnClose.Add_MouseEnter({ $btnClose.ForeColor = $cRed })
$btnClose.Add_MouseLeave({ $btnClose.ForeColor = $cGray })
$topBar.Controls.Add($btnClose)

# Drag on topBar too
$topBar.Add_MouseDown({ param($s,$e)
    if($e.Button -eq [System.Windows.Forms.MouseButtons]::Left){
        $isDragging = $true
        $dragStart  = [System.Drawing.Point]::new($e.X + $topBar.Left, $e.Y + $topBar.Top)
    }
})
$topBar.Add_MouseMove({ param($s,$e)
    if($isDragging){
        $form.Left += $e.X - ($dragStart.X - $topBar.Left)
        $form.Top  += $e.Y - ($dragStart.Y - $topBar.Top)
    }
})
$topBar.Add_MouseUp({ $isDragging = $false })

# ──────────────── LEFT PANEL (Auth) ────────────────
$leftPanel = New-Object System.Windows.Forms.Panel
$leftPanel.Left      = 0
$leftPanel.Top       = 44
$leftPanel.Width     = 260
$leftPanel.Height    = 636
$leftPanel.BackColor = $cPanel
$form.Controls.Add($leftPanel)

# Separator line (right edge of left panel)
$sepLine = New-Object System.Windows.Forms.Panel
$sepLine.Left      = 259
$sepLine.Top       = 44
$sepLine.Width     = 1
$sepLine.Height    = 636
$sepLine.BackColor = $cPanelBorder
$form.Controls.Add($sepLine)

# System label
$lblSys = New-Object System.Windows.Forms.Label
$lblSys.Text      = "SYSTEM ACCESS"
$lblSys.ForeColor = $cTeal
$lblSys.Font      = $fontLabel
$lblSys.AutoSize  = $true
$lblSys.Left      = 20
$lblSys.Top       = 32
$leftPanel.Controls.Add($lblSys)

# Horizontal rule
$hrTop = New-Object System.Windows.Forms.Panel
$hrTop.Left      = 20
$hrTop.Top       = 52
$hrTop.Width     = 220
$hrTop.Height    = 1
$hrTop.BackColor = $cPanelBorder
$leftPanel.Controls.Add($hrTop)

# Access code label
$lblCode = New-Object System.Windows.Forms.Label
$lblCode.Text      = "ACCESS CODE"
$lblCode.ForeColor = $cGray
$lblCode.Font      = $fontMonoSm
$lblCode.AutoSize  = $true
$lblCode.Left      = 20
$lblCode.Top       = 70
$leftPanel.Controls.Add($lblCode)

# Password box
$codeBox = New-Object System.Windows.Forms.TextBox
$codeBox.Left                  = 20
$codeBox.Top                   = 90
$codeBox.Width                 = 220
$codeBox.Height                = 32
$codeBox.PasswordChar          = "•"
$codeBox.UseSystemPasswordChar = $false
$codeBox.BackColor             = $cGrayDim
$codeBox.ForeColor             = $cWhite
$codeBox.Font                  = $fontMono
$codeBox.BorderStyle           = "FixedSingle"
$leftPanel.Controls.Add($codeBox)

# Activate button
$startBtn = New-Object System.Windows.Forms.Button
$startBtn.Text      = "ACTIVATE"
$startBtn.Left      = 20
$startBtn.Top       = 136
$startBtn.Width     = 220
$startBtn.Height    = 36
$startBtn.BackColor = $cTeal
$startBtn.ForeColor = $cBG
$startBtn.Font      = $fontBtn
$startBtn.FlatStyle = "Flat"
$startBtn.FlatAppearance.BorderSize = 0
$startBtn.Cursor    = [System.Windows.Forms.Cursors]::Hand
$startBtn.Add_MouseEnter({ $startBtn.BackColor = [System.Drawing.Color]::FromArgb(255,0,240,210) })
$startBtn.Add_MouseLeave({ $startBtn.BackColor = $cTeal })
$leftPanel.Controls.Add($startBtn)

# Status indicator
$lblStatus = New-Object System.Windows.Forms.Label
$lblStatus.Text      = "● STANDBY"
$lblStatus.ForeColor = $cGray
$lblStatus.Font      = $fontMonoSm
$lblStatus.AutoSize  = $true
$lblStatus.Left      = 20
$lblStatus.Top       = 186
$leftPanel.Controls.Add($lblStatus)

# Progress bar label
$lblProg = New-Object System.Windows.Forms.Label
$lblProg.Text      = "PROGRESS"
$lblProg.ForeColor = $cGray
$lblProg.Font      = $fontMonoSm
$lblProg.AutoSize  = $true
$lblProg.Left      = 20
$lblProg.Top       = 216
$leftPanel.Controls.Add($lblProg)

# Progress bar
$progress = New-Object System.Windows.Forms.ProgressBar
$progress.Left   = 20
$progress.Top    = 234
$progress.Width  = 220
$progress.Height = 6
$progress.Minimum= 0
$progress.Maximum= 100
$progress.Value  = 0
$progress.Style  = "Continuous"
$leftPanel.Controls.Add($progress)

$hrMid = New-Object System.Windows.Forms.Panel
$hrMid.Left      = 20
$hrMid.Top       = 282
$hrMid.Width     = 220
$hrMid.Height    = 1
$hrMid.BackColor = $cPanelBorder
$leftPanel.Controls.Add($hrMid)

$yMod = 292
foreach($mod in $modules){
    $dot = New-Object System.Windows.Forms.Panel
    $dot.Left      = 20
    $dot.Top       = $yMod + 5
    $dot.Width     = 4
    $dot.Height    = 4
    $dot.BackColor = $cGray
    $leftPanel.Controls.Add($dot)

    $lbl = New-Object System.Windows.Forms.Label
    $lbl.Text      = $mod.Name
    $lbl.ForeColor = $cGray
    $lbl.Font      = $fontMonoSm
    $lbl.AutoSize  = $true
    $lbl.Left      = 30
    $lbl.Top       = $yMod
    $leftPanel.Controls.Add($lbl)
    $yMod += 22
}

# ──────────────── RIGHT PANEL (Log) ────────────────
$rightPanel = New-Object System.Windows.Forms.Panel
$rightPanel.Left      = 261
$rightPanel.Top       = 44
$rightPanel.Width     = 639
$rightPanel.Height    = 636
$rightPanel.BackColor = $cBG
$form.Controls.Add($rightPanel)

# Log header
$lblLog = New-Object System.Windows.Forms.Label
$lblLog.Text      = "OUTPUT LOG"
$lblLog.ForeColor = $cTeal
$lblLog.Font      = $fontLabel
$lblLog.AutoSize  = $true
$lblLog.Left      = 20
$lblLog.Top       = 16
$rightPanel.Controls.Add($lblLog)

$lblLogSub = New-Object System.Windows.Forms.Label
$lblLogSub.Text      = "— SYSTEM MESSAGES"
$lblLogSub.ForeColor = $cGray
$lblLogSub.Font      = $fontMonoSm
$lblLogSub.AutoSize  = $true
$lblLogSub.Left      = 105
$lblLogSub.Top       = 18
$rightPanel.Controls.Add($lblLogSub)

$hrLog = New-Object System.Windows.Forms.Panel
$hrLog.Left      = 20
$hrLog.Top       = 38
$hrLog.Width     = 600
$hrLog.Height    = 1
$hrLog.BackColor = $cPanelBorder
$rightPanel.Controls.Add($hrLog)

# RichTextBox log
$statusBox = New-Object System.Windows.Forms.RichTextBox
$statusBox.Left       = 20
$statusBox.Top        = 48
$statusBox.Width      = 600
$statusBox.Height     = 570
$statusBox.BackColor  = $cBG
$statusBox.ForeColor  = $cWhite
$statusBox.Font       = $fontMono
$statusBox.ReadOnly   = $true
$statusBox.BorderStyle= "None"
$statusBox.ScrollBars = "Vertical"
$rightPanel.Controls.Add($statusBox)
$global:statusBox = $statusBox

# ──────────────── SHOW-STATUS ────────────────
function Show-Status {
    param([string]$Message, [string]$Color = "White")
    $colorMap = @{
        "Teal"   = $cTeal
        "Amber"  = $cAmber
        "Green"  = $cGreen
        "Red"    = $cRed
        "Gray"   = $cGray
        "White"  = $cWhite
        "Cyan"   = $cTeal
        "Orange" = $cAmber
        "Lime"   = $cGreen
        "Yellow" = $cAmber
        "Magenta"= [System.Drawing.Color]::FromArgb(255,180,80,240)
        "Violet" = [System.Drawing.Color]::FromArgb(255,140,100,240)
        "HotPink"= [System.Drawing.Color]::FromArgb(255,240,80,160)
        "Pink"   = [System.Drawing.Color]::FromArgb(255,240,80,160)
        "DeepSkyBlue" = $cTeal
    }
    if($colorMap.ContainsKey($Color)){
        $global:statusBox.SelectionColor = $colorMap[$Color]
    } else {
        $global:statusBox.SelectionColor = $cWhite
    }
    $global:statusBox.AppendText($Message + [Environment]::NewLine)
    $global:statusBox.ScrollToCaret()
    Start-Sleep -Milliseconds 180
}

# ──────────────── ACTIVATE CLICK ────────────────
$startBtn.Add_Click({
    $statusBox.Clear()
    $progress.Value = 0
    $lblStatus.Text      = "● STANDBY"
    $lblStatus.ForeColor = $cGray

    if($codeBox.Text -ne "Khamaitai-001-203-403-V2"){
        [System.Windows.Forms.MessageBox]::Show("Access denied.", "KUN KHAMAITAI PROJECT")
        $lblStatus.Text      = "● AUTH FAILED"
        $lblStatus.ForeColor = $cRed
        return
    }

    $lblStatus.Text      = "● RUNNING"
    $lblStatus.ForeColor = $cTeal
    $progress.Value = 5

    try {
        Show-Status "┌───────────────────────────────────────────────────────────┐" "Teal"
        Show-Status "│  KUN KHAMAITAI PROJECT  ·  SYSTEM OPTIMIZER               │" "White"
        Show-Status "└───────────────────────────────────────────────────────────┘" "Teal"
        Show-Status ""

        Show-Status "[SYS]    Enabling 1ms timer precision..." "Teal"
        [WinTimer]::timeBeginPeriod(1) | Out-Null
        $progress.Value = 18

        Show-Status "[POWER]  Applying Ultimate Performance plan..." "Amber"
        Start-Process -WindowStyle Hidden -FilePath "powercfg.exe" -ArgumentList "-setactive SCHEME_MIN" -Wait
        $progress.Value = 30

        Show-Status "[INPUT]  Keyboard repeat speed tuning..." "Violet"
        Set-ItemProperty -Path "HKCU:\Control Panel\Keyboard" -Name "KeyboardDelay" -Value "0"
        Set-ItemProperty -Path "HKCU:\Control Panel\Keyboard" -Name "KeyboardSpeed" -Value "31"

        Show-Status "[INPUT]  Mouse acceleration disabled..." "Violet"
        Set-ItemProperty -Path "HKCU:\Control Panel\Mouse" -Name "MouseSpeed"     -Value "0"
        Set-ItemProperty -Path "HKCU:\Control Panel\Mouse" -Name "MouseThreshold1"-Value "0"
        Set-ItemProperty -Path "HKCU:\Control Panel\Mouse" -Name "MouseThreshold2"-Value "0"
        $progress.Value = 46

        Show-Status "[SYS]    Foreground priority profile..." "Teal"
        New-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\PriorityControl" -Name "Win32PrioritySeparation" -PropertyType DWord -Value 38 -Force | Out-Null
        $progress.Value = 58

        Show-Status "[NET]    Flushing DNS cache..." "Amber"
        Start-Process -WindowStyle Hidden -FilePath "ipconfig.exe" -ArgumentList "/flushdns" -Wait

        Show-Status "[NET]    Optimizing TCP profile..." "Amber"
        Start-Process -WindowStyle Hidden -FilePath "netsh.exe" -ArgumentList "int tcp set global autotuninglevel=disabled" -Wait
        Start-Process -WindowStyle Hidden -FilePath "netsh.exe" -ArgumentList "int tcp set global rss=enabled" -Wait
        Start-Process -WindowStyle Hidden -FilePath "netsh.exe" -ArgumentList "int tcp set global chimney=enabled" -Wait
        $progress.Value = 72

        Show-Status "[APP]    Closing heavy background apps..." "Magenta"
        $apps = "OneDrive","Skype","Teams","XboxAppServices","YourPhone","SteamWebHelper","Copilot"
        foreach($a in $apps){
            Get-Process $a -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
        }
        $progress.Value = 84

        Show-Status "[TEMP]   Cleaning user temp files..." "Gray"
        Remove-Item "$env:TEMP\*" -Recurse -Force -ErrorAction SilentlyContinue

        Show-Status "[TEMP]   Cleaning Windows temp files..." "Gray"
        Remove-Item "C:\Windows\Temp\*" -Recurse -Force -ErrorAction SilentlyContinue
        $progress.Value = 96

        Show-Status ""
        Show-Status "────────────────────────────────────────────────────────────" "Teal"
        Show-Status "[DONE]   All modules complete. System optimized." "Green"
        Show-Status "────────────────────────────────────────────────────────────" "Teal"

        $progress.Value      = 100
        $lblStatus.Text      = "● COMPLETE"
        $lblStatus.ForeColor = $cGreen
    }
    catch {
        [System.Windows.Forms.MessageBox]::Show("Run this program as Administrator.", "KUN KHAMAITAI PROJECT")
        Show-Status "[WARN]   Some commands require administrator rights." "Amber"
        $lblStatus.Text      = "● WARN"
        $lblStatus.ForeColor = $cAmber
    }
})

$form.Add_Shown({ $form.Activate() })
[void]$form.ShowDialog()
